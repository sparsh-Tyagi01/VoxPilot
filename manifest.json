{
  "manifest_version": 3,
  "name": "VoxPilot",
  "short_name": "VoxPilot",
  "description": "Autonomous on-device voice AI agent for hands-free browser control. 100% private — all processing runs on your device.",
  "version": "0.1.0",

  "permissions": [
    "offscreen",
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "alarms"
  ],

  "optional_permissions": ["tabs", "debugger"],

  "optional_host_permissions": ["https://*/*", "http://*/*"],

  "background": {
    "service_worker": "src/sw/sw.ts",
    "type": "module"
  },

  "side_panel": {
    "default_path": "src/panel/panel.html"
  },

  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": true
  },

  "action": {
    "default_title": "VoxPilot",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    }
  },

  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Alt+V"
      },
      "description": "Toggle voice listening on/off"
    }
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/content.ts"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://huggingface.co https://cdn-lfs.hf.co https://cdn-lfs-us-1.hf.co https://huggingface.co/api/ https://raw.githubusercontent.com"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/offscreen/offscreen.html",
        "src/onboarding/onboarding.html",
        "src/settings/settings.html"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "icons": {
    "16": "src/icons/icon-16.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  }
}
