{
  "manifest_version": 3,
  "name": "VoxPilot",
  "short_name": "VoxPilot",
  "description": "Voice browser control with local speech recognition, site-aware actions, and optional explicitly enabled hosted planning.",
  "version": "0.1.0",
  "permissions": [
    "offscreen",
    "activeTab",
    "tabs",
    "scripting",
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/sw/sw.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "src/settings/settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "VoxPilot",
    "default_icon": {
      "16": "src/icons/icon-16.png",
      "48": "src/icons/icon-48.png",
      "128": "src/icons/icon-128.png"
    },
    "default_popup": "src/panel/panel.html"
  },
  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Alt+V"
      },
      "description": "Toggle voice listening on/off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/content.ts"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* https://huggingface.co https://*.huggingface.co https://*.hf.co https://cdn-lfs.hf.co https://cdn-lfs-us-1.hf.co https://raw.githubusercontent.com https://cdn.jsdelivr.net"
  },
  "icons": {
    "16": "src/icons/icon-16.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png"
  }
}
